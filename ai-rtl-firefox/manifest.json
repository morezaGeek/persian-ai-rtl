{
  "manifest_version": 3,
  "name": "AI RTL",
  "short_name": "AI RTL",
  "description": "راست‌چین‌سازی متن در سایت‌های هوش مصنوعی و گوگل؛ با انتخاب جداگانهٔ فونت فارسی و انگلیسی و اندازهٔ متن برای هر سایت.",
  "version": "1.3.1",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "AI RTL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://antigravity.static.usercontent.goog/*"
      ],
      "js": [
        "hosts.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://antigravity.static.usercontent.goog/*"
      ],
      "js": [
        "hosts.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Vazirmatn-Variable.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-rtl@local.extension"
    }
  }
}
